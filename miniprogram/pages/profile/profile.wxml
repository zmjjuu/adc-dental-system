<view class="page" wx:if="{{patient}}">
  <view class="card">
    <view class="card-title">👤 {{patient.name}} <text class="mono muted">{{patient.account_no}}</text></view>
    <view class="kv">
      <view class="kv-row"><view class="kv-k">出生日期</view><view class="kv-v">{{patient.birth_date}}</view></view>
      <view class="kv-row"><view class="kv-k">电话</view><view class="kv-v">{{patient.phone}}</view></view>
      <view class="kv-row"><view class="kv-k">邮箱</view><view class="kv-v">{{patient.email || '未填写'}}</view></view>
      <view class="kv-row"><view class="kv-k">账单地址</view><view class="kv-v">{{patient.billing_address}}</view></view>
      <view class="kv-row"><view class="kv-k">紧急联系人</view><view class="kv-v">{{patient.emergency_contact_name}} · {{patient.emergency_contact_phone}}</view></view>
    </view>
    <button class="btn btn-ghost btn-block" style="margin-top:16rpx" bindtap="toggleEdit">
      {{editMode ? '收起编辑' : '✏️ 编辑联系方式'}}
    </button>
    <block wx:if="{{editMode}}">
      <view class="label">电话</view><input class="input" data-k="phone" bindinput="onField" value="{{f.phone}}" />
      <view class="label">邮箱</view><input class="input" data-k="email" bindinput="onField" value="{{f.email}}" />
      <view class="label">账单地址</view><input class="input" data-k="billing_address" bindinput="onField" value="{{f.billing_address}}" />
      <view class="label">紧急联系人</view><input class="input" data-k="emergency_contact_name" bindinput="onField" value="{{f.emergency_contact_name}}" />
      <view class="label">紧急联系人电话</view><input class="input" data-k="emergency_contact_phone" bindinput="onField" value="{{f.emergency_contact_phone}}" />
      <button class="btn btn-primary btn-block" style="margin-top:20rpx" bindtap="saveProfile">保存</button>
    </block>
  </view>

  <view class="card">
    <view class="card-title">📝 我的健康备注</view>
    <block wx:if="{{patient.allergies.length}}">
      <view class="allergy-item" wx:for="{{patient.allergies}}" wx:key="patient_allergy_id">
        <view style="min-width:120rpx;font-weight:600">{{item.allergy_name}}</view>
        <view class="badge {{item.st_cls}}">{{item.st_text}}</view>
        <view class="muted" style="flex:1">{{item.note || ''}}</view>
      </view>
    </block>
    <view wx:else class="hint">暂无备注。</view>
    <view class="section">＋ 添加备注（到店时服务人员会逐项核对）</view>
    <picker mode="selector" range="{{allergyTypes}}" range-key="allergy_name" value="{{newAllergyIdx}}" bindchange="onNewAllergy">
      <view class="picker">{{allergyTypes[newAllergyIdx].allergy_name}}</view>
    </picker>
    <view class="label">说明</view>
    <input class="input" value="{{newAllergyNote}}" bindinput="onNewNote" placeholder="如：接触乳胶制品后皮肤发红" />
    <button class="btn btn-ghost btn-block" style="margin-top:16rpx" bindtap="addAllergy">添加备注</button>
  </view>

  <view class="card">
    <view class="card-title">ℹ️ 关于</view>
    <view class="hint">
      <view>ADC 日常记录 · 个人服务记录查看工具</view>
      <view>本系统为课程设计演示，所有数据均为模拟数据</view>
      <view>模式：{{offline ? '离线演示模式（数据在手机本地）' : '在线模式（连接云端）'}}</view>
      <view>咨询电话：0571-88001001</view>
    </view>
  </view>

  <button class="btn btn-danger btn-block" bindtap="logout">退出登录</button>
  <view style="height:30rpx"></view>
</view>
