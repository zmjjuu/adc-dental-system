<view class="page">
  <view class="btn-row" style="margin-bottom:16rpx">
    <input class="input" style="flex:1" value="{{query}}" bindinput="onQuery" placeholder="账号 / 姓名 / 电话" />
    <button class="btn btn-primary" bindtap="doSearch">检索</button>
    <button class="btn btn-ghost" bindtap="goCreate">＋ 建档</button>
  </view>

  <view class="card">
    <block wx:if="{{list.length}}">
      <view class="list-item" wx:for="{{list}}" wx:key="patient_id" bindtap="goPatient" data-id="{{item.patient_id}}">
        <view class="li-main">
          <view class="li-title">{{item.name}} <text class="mono muted">{{item.account_no}}</text></view>
          <view class="li-sub">{{item.phone}} · {{item.email ? item.email : '邮箱未填'}} · 过敏询问：{{item.allergy_inquiry_status}}</view>
        </view>
        <view class="badge b-purple" wx:if="{{item.allergy_cnt}}">{{item.allergy_cnt}} 项过敏</view>
      </view>
    </block>
    <view wx:else class="empty">{{loaded ? '没有匹配的患者' : '加载中…'}}</view>
  </view>
</view>
