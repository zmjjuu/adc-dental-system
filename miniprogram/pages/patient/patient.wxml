<!-- 建档模式 -->
<view class="page" wx:if="{{mode === 'create'}}">
  <view class="card">
    <view class="card-title">患者基本信息（邮箱可不填）</view>
    <view class="label">姓名 *</view><input class="input" data-k="name" bindinput="onField" value="{{f.name}}" />
    <view class="label">出生日期 *</view>
    <picker mode="date" value="{{f.birth_date || '1990-01-01'}}" data-k="birth_date" bindchange="onField">
      <view class="picker">{{f.birth_date || '请选择'}}</view>
    </picker>
    <view class="label">电话 *</view><input class="input" type="number" data-k="phone" bindinput="onField" value="{{f.phone}}" />
    <view class="label">邮箱（可不填）</view><input class="input" data-k="email" bindinput="onField" value="{{f.email}}" />
    <view class="label">账单地址 *</view><input class="input" data-k="billing_address" bindinput="onField" value="{{f.billing_address}}" />
    <view class="label">紧急联系人 *</view><input class="input" data-k="emergency_contact_name" bindinput="onField" value="{{f.emergency_contact_name}}" />
    <view class="label">紧急联系人电话 *</view><input class="input" type="number" data-k="emergency_contact_phone" bindinput="onField" value="{{f.emergency_contact_phone}}" />
  </view>
  <view class="card">
    <view class="card-title">已知过敏（逐项勾选，多条不互相覆盖）</view>
    <view wx:for="{{allergyTypes}}" wx:key="allergy_type_id" style="display:flex;align-items:center;gap:12rpx;padding:10rpx 0">
      <checkbox-group bindchange="onAllergyToggle" data-id="{{item.allergy_type_id}}">
        <checkbox value="{{item.allergy_type_id}}" style="transform:scale(.8)" />
      </checkbox-group>
      <view>{{item.allergy_name}}</view>
    </view>
    <view class="hint" style="margin-top:10rpx">过敏初始状态为「待核实」，由接诊牙医诊前复核确认。</view>
  </view>
  <button class="btn btn-primary btn-block" loading="{{creating}}" bindtap="doCreate">保存档案</button>
  <view style="height:60rpx"></view>
</view>

<!-- 详情模式 -->
<view class="page" wx:if="{{mode === 'detail' && p}}">
  <view class="card">
    <view class="card-title">{{p.name}} <text class="mono muted">{{p.account_no}}</text></view>
    <view class="kv">
      <view class="kv-row"><view class="kv-k">出生日期</view><view class="kv-v">{{p.birth_date}}</view></view>
      <view class="kv-row"><view class="kv-k">账单地址</view><view class="kv-v">{{p.billing_address}}</view></view>
      <view class="kv-row"><view class="kv-k">电话 / 邮箱</view><view class="kv-v">{{p.phone}} · {{p.email ? p.email : '邮箱未填'}}</view></view>
      <view class="kv-row"><view class="kv-k">紧急联系人</view><view class="kv-v">{{p.emergency_contact_name}} · {{p.emergency_contact_phone}}</view></view>
      <view class="kv-row"><view class="kv-k">过敏询问</view><view class="kv-v">{{p.allergy_inquiry_status}}</view></view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">🧾 过敏记录（逐项）</view>
    <block wx:if="{{p.allergies.length}}">
      <view class="allergy-item" wx:for="{{p.allergies}}" wx:key="patient_allergy_id" wx:for-index="idx">
        <view style="min-width:120rpx;font-weight:600">{{item.allergy_name}}</view>
        <picker mode="selector" range="{{['待核实','已确认','已撤回']}}" data-idx="{{idx}}" bindchange="onAllergyStatus">
          <view class="badge {{item.st_cls}}">{{item.status}}</view>
        </picker>
        <input class="input" style="flex:1;padding:8rpx 14rpx" value="{{item.note}}" data-idx="{{idx}}" bindinput="onAllergyNote" placeholder="备注" />
        <view class="btn btn-sm btn-ghost" data-idx="{{idx}}" bindtap="saveAllergy">保存</view>
      </view>
    </block>
    <view wx:else class="hint">暂无过敏记录。</view>
    <view class="section">新增过敏项</view>
    <picker mode="selector" range="{{allergyTypes}}" range-key="allergy_name" value="{{newAllergyIdx}}" bindchange="onNewAllergy">
      <view class="picker">{{allergyTypes[newAllergyIdx].allergy_name}}</view>
    </picker>
    <view class="label">备注</view>
    <input class="input" value="{{newAllergyNote}}" bindinput="onNewNote" placeholder="如：接触乳胶手套出现皮疹" />
    <button class="btn btn-ghost btn-block" style="margin-top:16rpx" bindtap="addAllergy">添加过敏项</button>
  </view>

  <view class="card">
    <view class="card-title">📅 就诊记录（跨店统一账号）</view>
    <block wx:if="{{p.visits.length}}">
      <view class="list-item" wx:for="{{p.visits}}" wx:key="visit_id" bindtap="goVisit" data-id="{{item.visit_id}}">
        <view class="li-main">
          <view class="li-title mono">{{item.visit_no}}</view>
          <view class="li-sub">{{item.when}} · {{item.clinic_code}} · {{item.dentist_name}}</view>
        </view>
        <view class="badge {{item.st_cls}}">{{item.status}}</view>
      </view>
    </block>
    <view wx:else class="hint">暂无就诊记录。</view>
  </view>
</view>
