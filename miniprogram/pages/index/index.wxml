<view class="page">
  <view class="card">
    <view class="card-title">🦷 {{user.display_name}} 的工作台</view>
    <view class="muted">岗位：{{roleNames}} · 安德鲁牙科连锁管理系统</view>
  </view>

  <view class="stat-grid" wx:if="{{stats.length}}">
    <view class="stat {{item.warn ? 'warn' : ''}} {{item.danger ? 'danger' : ''}}" wx:for="{{stats}}" wx:key="t">
      <b>{{item.n}}</b><span>{{item.t}}</span>
    </view>
  </view>

  <view class="card">
    <view class="card-title">快捷办理</view>
    <view class="btn-row">
      <button class="btn btn-primary" wx:for="{{quick}}" wx:key="url" bindtap="goQuick" data-url="{{item.url}}">
        {{item.icon}} {{item.t}}
      </button>
    </view>
    <view class="hint" style="margin-top:16rpx">流程：电话预约 → 登记到诊 → 记录并签署实际治疗 → 生成结算单 → 季度核算（基金 = 净利润 × 10%）</view>
  </view>

  <view class="card">
    <view class="card-title">最近预约</view>
    <block wx:if="{{recent.length}}">
      <view class="list-item" wx:for="{{recent}}" wx:key="visit_id" bindtap="goVisit" data-id="{{item.visit_id}}">
        <view class="li-main">
          <view class="li-title">{{item.patient_name}} · {{item.clinic_code}}</view>
          <view class="li-sub mono">{{item.visit_no}} · {{item.dentist_name}} · {{item.scheduled_start}}</view>
        </view>
        <view class="badge {{item.st_cls}}">{{item.status}}</view>
      </view>
    </block>
    <view wx:else class="empty">暂无预约</view>
  </view>
</view>
