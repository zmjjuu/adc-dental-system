<view class="page">
  <view class="hero">
    <view class="hero-main">
      <view class="hero-title">你好，{{patient.name}} 👋</view>
      <view class="hero-sub">安德鲁牙科 · 手机预约，到店即诊</view>
    </view>
    <view class="hero-btn" bindtap="goBook">立即预约</view>
  </view>

  <view class="card">
    <view class="card-title">🏥 我们的诊所</view>
    <view class="list-item" wx:for="{{clinics}}" wx:key="clinic_id">
      <view class="li-main">
        <view class="li-title">{{item.clinic_code}}</view>
        <view class="li-sub">{{item.postal_address}} · ☎ {{item.phone}}</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">🩺 诊疗项目与价格</view>
    <view class="tt-grid">
      <view class="tt-item" wx:for="{{treatments}}" wx:key="treatment_type_id" bindtap="goBook">
        <view class="tt-name">{{item.treatment_name}}</view>
        <view class="tt-price">{{item.price}}<text class="tt-unit">/{{item.unit_name}}</text></view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">💡 就诊提示</view>
    <view class="hint">· 预约成功后请按时到店，前台核对身份后安排就诊<br>· 如需改期或取消，可在「我的预约」中自助办理<br>· 过敏史请提前在「我的 → 我的档案」中登记，就诊时医生会逐项复核</view>
  </view>
</view>
