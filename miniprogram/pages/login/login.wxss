.login-wrap {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 40rpx;
  background: linear-gradient(160deg, #0f766e 0%, #115e59 45%, #134e4a 75%, #1e3a5f 100%);
  box-sizing: border-box;
}
.login-card {
  background: #ffffff;
  border-radius: 36rpx;
  padding: 60rpx 48rpx 48rpx;
  width: 100%;
  max-width: 640rpx;
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.28);
}
.login-logo {
  width: 140rpx;
  height: 140rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: linear-gradient(135deg, #0d9488, #134e4a);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  box-shadow: 0 10rpx 30rpx rgba(13, 148, 136, 0.4);
}
.login-title {
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #134e4a;
  margin-top: 28rpx;
  letter-spacing: 4rpx;
}
.login-sub {
  text-align: center;
  color: #94a3b8;
  font-size: 24rpx;
  margin: 10rpx 0 44rpx;
  letter-spacing: 1rpx;
}
.login-btn {
  margin-top: 36rpx;
  height: 92rpx;
  font-size: 32rpx;
  letter-spacing: 8rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #0d9488, #0f766e);
  border: 0;
}
.demo-box {
  margin-top: 32rpx;
  background: #f0fdfa;
  border: 2rpx solid #ccfbf1;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}
.demo-title { font-size: 24rpx; font-weight: 600; color: #0f766e; margin-bottom: 8rpx; }
.demo-line { font-size: 22rpx; color: #475569; line-height: 1.9; }
.login-tip {
  color: #94a3b8;
  font-size: 22rpx;
  text-align: center;
  margin-top: 24rpx;
  line-height: 1.6;
}
