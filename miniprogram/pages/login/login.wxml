<view class="login-wrap">
  <view class="login-card">
    <view class="login-logo">🦷</view>
    <view class="login-title">安德鲁牙科连锁管理系统</view>
    <view class="login-sub">Andrew's Dental Chain · ADC</view>

    <view class="label">选择岗位账号（演示密码均为 123456）</view>
    <picker mode="selector" range="{{accounts}}" value="{{index}}" bindchange="onPick">
      <view class="picker picker-account">
        <view style="flex:1">
          <view class="acc-label">{{accounts[index]}}</view>
        </view>
        <view class="acc-arrow">▾</view>
      </view>
    </picker>
    <view class="acc-role">{{accountRoles[index]}}</view>

    <view class="label">密码</view>
    <input class="input" password value="{{password}}" bindinput="onPwd" placeholder="演示密码 123456" />

    <button class="btn btn-primary btn-block login-btn" loading="{{loading}}" bindtap="onLogin">登 录</button>
    <view class="login-tip">连接不上服务器时自动切换「离线演示模式」，数据在手机本地，可在「我的」页重置</view>
  </view>
</view>
