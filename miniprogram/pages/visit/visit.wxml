<view class="page" wx:if="{{v}}">
  <view class="card">
    <view class="kv">
      <view class="kv-row"><view class="kv-k">记录编号</view><view class="kv-v mono">{{v.visit_no}}
        <text class="badge {{v.st_cls}}">{{v.statusText}}</text></view></view>
      <view class="kv-row"><view class="kv-k">门店</view><view class="kv-v">{{v.clinic_code}} · {{v.clinic_address}}</view></view>
      <view class="kv-row"><view class="kv-k">服务人员</view><view class="kv-v">{{v.dentist_name}}</view></view>
      <view class="kv-row"><view class="kv-k">安排时间</view><view class="kv-v">{{v.when}} ~ {{v.whenEnd}}</view></view>
      <view class="kv-row" wx:if="{{v.requested_treatments}}"><view class="kv-k">需求备注</view><view class="kv-v">{{v.requested_treatments}}</view></view>
      <view class="kv-row" wx:if="{{v.reason}}"><view class="kv-k">备注</view><view class="kv-v">{{v.reason}}</view></view>
      <view class="kv-row" wx:if="{{v.previous_no}}"><view class="kv-k">改期记录</view><view class="kv-v">由 {{v.previous_no}} 改期而来</view></view>
    </view>
  </view>

  <view class="card" wx:if="{{v.treatments.length}}">
    <view class="card-title">💳 服务明细</view>
    <view class="tbl-wrap"><table class="tbl">
      <tr><th>项目</th><th>数量</th><th>单价</th><th>小计</th></tr>
      <tr wx:for="{{v.treatments}}" wx:key="treatment_id">
        <td>{{item.treatment_name}}</td>
        <td class="num">{{item.units}}</td>
        <td class="num">{{item.price}}</td>
        <td class="num">{{item.sub}}</td>
      </tr>
    </table></view>
  </view>

  <view class="card" wx:if="{{v.invoice}}">
    <view class="card-title">🧾 消费账单</view>
    <view class="kv-row"><view class="kv-k">单号</view><view class="kv-v mono">{{v.invoice.invoice_no}}</view></view>
    <view class="total-line">合计 <b>{{invoiceTotal}}</b></view>
    <button class="btn btn-ghost btn-block" style="margin-top:16rpx" bindtap="goInvoice">查看账单明细</button>
  </view>
</view>

<view class="empty" wx:if="{{!v && !loading}}">加载失败</view>
